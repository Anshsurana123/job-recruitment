# Git ignore rules for Redrob Hackathon Ranker

# Android / Gradle / IntelliJ defaults
*.iml
.gradle
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
.kotlin/

# Secrets and environment configs
.env

# Large data and index files (MUST NOT push to GitHub)
candidates.jsonl
candidates.jsonl.gz
bm25_index_full.pkl
bm25_index_sample.pkl
*runs_data_and_ai_challenge*
__MACOSX/

