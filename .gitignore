scratch/
extreme_anomalies.txt
suspected_honeypots.txt
strict_honeypots.txt
team_proud_franklin_sample.csv

# Document downloads (original specs/JDs)
*.docx
*.doc

# Python cache files
__pycache__/
*.pyc
.pytest_cache/

# Large database and cache directories
talent_radar/chroma_db/
talent_radar/graphify-out/
